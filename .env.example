# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development  # development, staging, production
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# Database Configuration
DB_TYPE=file  # file or postgres
DB_FILE_PATH=posts.json

# PostgreSQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postanalyzer
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Security Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
MAX_BODY_SIZE=1048576  # 1MB in bytes
ALLOWED_ORIGINS=*  # Comma-separated list or * for all
TRUSTED_PROXIES=  # Comma-separated list of trusted proxy IPs

# Logging Configuration
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout or file path
LOG_TIME_FORMAT=2006-01-02T15:04:05Z07:00

# External API Configuration
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com/posts
HTTP_TIMEOUT=30s

# RPC (Kitex) — gateway dials these; postsvc/authsvc bind to them
POSTSVC_ADDR=127.0.0.1:9001
AUTHSVC_ADDR=127.0.0.1:9002
RPC_MUX=true  # Kitex connection multiplexing

# Auth / ABAC (authsvc)
JWT_SECRET=dev-only-change-me-in-production
JWT_TTL=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123  # demo editor/viewer accounts: editor/editor123, viewer/viewer123

# Redis cache (postsvc). Falls back to in-memory cache if unreachable.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Messaging — each broker is independently opt-in; a disabled/unreachable
# broker only turns off its own feature, it never blocks startup.
KAFKA_ENABLED=false
KAFKA_BROKERS=127.0.0.1:9092
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
ROCKETMQ_ENABLED=false
ROCKETMQ_NAMESRV_ADDRS=127.0.0.1:9876
