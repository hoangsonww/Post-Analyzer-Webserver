project_id  = "your-gcp-project-id"
project     = "post-analyzer"
environment = "dev"
region      = "us-central1"

# Don't put real secrets in a checked-in tfvars file. Prefer:
#   TF_VAR_db_password=... terraform apply
# or a secrets manager / CI secret store.
