meta {
  name: Login as editor
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "editor",
    "password": "editor123"
  }
}

script:post-response {
  bru.setVar("token", res.getBody().data.token);
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
