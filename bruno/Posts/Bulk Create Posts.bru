    "posts": [
      { "userId": 1, "title": "Bulk 1", "body": "First bulk post" },
      { "userId": 1, "title": "Bulk 2", "body": "Second bulk post" }
    ]
  }
}

tests {
  test("status 201 or 207", function() {
    expect([201, 207]).to.include(res.getStatus());
  });
}
