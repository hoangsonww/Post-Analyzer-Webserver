meta {
  name: Create Post
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/posts
  body: json
  auth: inherit
}

body:json {
  {
    "userId": 1,
    "title": "Hello from Postman",
    "body": "Created via the Post Analyzer collection"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("postId", String(body.data.id));
}

tests {
  const body = res.getBody();
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("has id", function() {
    expect(body.data.id).to.be.a("number");
  });
}
