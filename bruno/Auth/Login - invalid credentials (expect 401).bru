meta {
  name: Login - invalid credentials (expect 401)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "wrong"
  }
}

tests {
  test("status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
