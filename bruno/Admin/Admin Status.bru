meta {
  name: Admin Status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/status
  body: none
  auth: inherit
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has integrations block", function() {
    expect(res.getBody().data).to.have.property("integrations");
  });
}
